# Desarrollo local: mismos valores predeterminados que main.
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
POSTGRES_DB=streaming_db
POSTGRES_PORT=5432
METRICS_PORT=8004
AUDIO_PORT=8003
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
MINIO_USER=minioadmin
MINIO_PASS=minioadminpassword
# Obligatorio. Generar uno propio de 32+ caracteres: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_secret_before_use
# Cuentas administradoras (separadas por coma). Se promueven al arrancar user_service
ADMIN_EMAILS=
NOTIFICATION_PORT=8005
ROOMS_PORT=8006
# Copias del worker de ingesta (Worker Pool). Cada una procesa una canción a la vez
WORKER_REPLICAS=3
# 0.0.0.0 abre el front a la red local (solo para demos)
FRONTEND_BIND=127.0.0.1
