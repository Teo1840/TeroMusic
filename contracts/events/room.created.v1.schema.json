{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/room.created.v1.schema.json",
  "title": "room.created.v1",
  "description": "Un usuario creó una sala en vivo (Party Room). Publica: rooms_service. Consumen: metrics_service, notification_service.",
  "type": "object",
  "required": ["room_id", "host_id", "name", "visibility"],
  "additionalProperties": false,
  "properties": {
    "room_id": { "type": "string", "format": "uuid" },
    "host_id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "visibility": { "type": "string", "enum": ["public", "private"] },
    "max_listeners": { "type": "integer", "minimum": 2, "maximum": 500 }
  }
}
