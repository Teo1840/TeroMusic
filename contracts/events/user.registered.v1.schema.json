{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events/user.registered.v1.schema.json",
  "title": "user.registered.v1",
  "description": "Un usuario completó el registro. Publica: user_service. Consumen: notification_service, metrics_service, catalog_service. display_name es el nombre de artista que se muestra en el catálogo.",
  "type": "object",
  "required": ["user_id", "email", "username"],
  "additionalProperties": false,
  "properties": {
    "user_id": { "type": "string", "format": "uuid" },
    "email": { "type": "string", "format": "email" },
    "username": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-zA-Z0-9_.]+$" },
    "display_name": { "type": "string", "maxLength": 64 },
    "locale": { "description": "Idioma preferido para notificaciones (BCP 47).", "type": "string", "default": "es-UY" }
  }
}
